#priority 50
import crafttweaker.item.IItemStack;
import crafttweaker.item.IIngredient;
import mods.farmersdelight.CuttingBoard;

// Animania Prime Meat Cutting Board Recipes (Yields 2x Base Vanilla Meat)

// Raw Meats
CuttingBoard.addRecipe("cut_raw_prime_beef", [<animania:raw_prime_beef>], [<minecraft:beef> * 2]);
CuttingBoard.addRecipe("cut_raw_prime_steak", [<animania:raw_prime_steak>], [<minecraft:beef> * 2]);
CuttingBoard.addRecipe("cut_raw_prime_pork", [<animania:raw_prime_pork>], [<minecraft:porkchop> * 2]);
CuttingBoard.addRecipe("cut_raw_prime_bacon", [<animania:raw_prime_bacon>], [<minecraft:porkchop> * 2]);
CuttingBoard.addRecipe("cut_raw_prime_chicken", [<animania:raw_prime_chicken>], [<minecraft:chicken> * 2]);
CuttingBoard.addRecipe("cut_raw_prime_mutton", [<animania:raw_prime_mutton>], [<minecraft:mutton> * 2]);
CuttingBoard.addRecipe("cut_raw_prime_chevon", [<animania:raw_prime_chevon>], [<minecraft:mutton> * 2]);
CuttingBoard.addRecipe("cut_raw_prime_rabbit", [<animania:raw_prime_rabbit>], [<minecraft:rabbit> * 2]);
CuttingBoard.addRecipe("cut_raw_prime_peacock", [<animania:raw_prime_peacock>], [<minecraft:chicken> * 2]);

// Cooked Meats
CuttingBoard.addRecipe("cut_cooked_prime_beef", [<animania:cooked_prime_beef>], [<minecraft:cooked_beef> * 2]);
CuttingBoard.addRecipe("cut_cooked_prime_steak", [<animania:cooked_prime_steak>], [<minecraft:cooked_beef> * 2]);
CuttingBoard.addRecipe("cut_cooked_prime_pork", [<animania:cooked_prime_pork>], [<minecraft:cooked_porkchop> * 2]);
CuttingBoard.addRecipe("cut_cooked_prime_bacon", [<animania:cooked_prime_bacon>], [<minecraft:cooked_porkchop> * 2]);
CuttingBoard.addRecipe("cut_cooked_prime_chicken", [<animania:cooked_prime_chicken>], [<minecraft:cooked_chicken> * 2]);
CuttingBoard.addRecipe("cut_cooked_prime_mutton", [<animania:cooked_prime_mutton>], [<minecraft:cooked_mutton> * 2]);
CuttingBoard.addRecipe("cut_cooked_prime_chevon", [<animania:cooked_prime_chevon>], [<minecraft:cooked_mutton> * 2]);
