[// Disable Grimoire of Gaia Mimic and Ancient Vase
  {
    "mob": ["grimoireofgaia:mimic", "grimoireofgaia:vase"],
    "result": "deny",
    "onjoin": true
  },
// Deny Dark Druid spawning during the day (make it night-only)
  {
    "mob": "thebetweenlands:dark_druid",
    "mintime": 0,
    "maxtime": 13000,
    "result": "deny",
    "onjoin": true
  },
{
    "mob": "thebetweenlands:dark_druid",
    "mintime": 23000,
    "maxtime": 24000,
    "result": "deny",
    "onjoin": true
  },
