# Arcana Quest — track only pack-synced content in this CurseForge instance.
# Ignore everything at the instance root by default.
/*

# Keep tracked pack directories
!/config/
!/scripts/
!/minemenu/
!/resources/
!/structures/
!/resourcepacks/

# Within resourcepacks, only sync Stoneborn-Vanilla-HUD.zip
/resourcepacks/*
!/resourcepacks/Stoneborn-Vanilla-HUD.zip

# Keep tracked root files
!/.gitignore
!/manifest.json
!/modlist.html
!/knownkeys.txt
!/options.txt
!/user-prefs.json

# Ignored
.curseclient
/config/BiomeTweaker/output/
/config/packcompanion/output/
